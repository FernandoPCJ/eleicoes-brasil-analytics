                      "fontSize": "12pt",
                      "color": "#dce6f0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Como partidos e estados se comparam entre si?",
                    "textStyle": {
                      "fontSize": "12pt",
