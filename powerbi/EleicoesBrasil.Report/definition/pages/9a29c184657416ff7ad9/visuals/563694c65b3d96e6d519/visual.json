                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#f2a541"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Mulheres e pessoas negras estão representadas nas candidaturas?",
