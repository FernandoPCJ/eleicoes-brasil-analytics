model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaDados", "CarregarCSV", "fato_candidatura", "dim_candidato", "dim_cargo", "dim_estado", "dim_partido"]

annotation PBI_ProTooling = ["DevMode"]

ref table fato_candidatura
ref table dim_candidato
ref table dim_cargo
ref table dim_estado
ref table dim_partido

ref cultureInfo pt-BR

